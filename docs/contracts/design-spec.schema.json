{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "product_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "background": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 20
    },
    "target_users": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 20
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "functional",
              "nonfunctional"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "priority": {
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "priority",
          "acceptance_criteria"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "technical_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 30
    },
    "development_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 30
    },
    "delivery_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 30
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 30
    },
    "supplemental_text": {
      "type": "string",
      "maxLength": 12000
    },
    "confirmed_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "schema_version",
    "product_name",
    "background",
    "goals",
    "target_users",
    "requirements",
    "technical_constraints",
    "development_constraints",
    "delivery_requirements",
    "acceptance_criteria",
    "supplemental_text",
    "confirmed_assumptions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowStudio DesignSpecContent v1"
}
