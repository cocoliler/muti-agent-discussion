{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "assigned_role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 0,
            "maxItems": 99,
            "uniqueItems": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "spec"
                    },
                    "requirement_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "kind",
                    "requirement_id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "task"
                    },
                    "task_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    },
                    "deliverable_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "kind",
                    "task_id",
                    "deliverable_id"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 0,
            "maxItems": 200
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 30
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "minItems": 1,
            "maxItems": 30
          },
          "source_requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 0,
            "maxItems": 200,
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "impact": {
                  "enum": [
                    "low",
                    "critical"
                  ]
                }
              },
              "required": [
                "id",
                "text",
                "impact"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 30
          },
          "estimated_effort": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "min_hours": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "max_hours": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "is_estimate": {
                    "const": true
                  }
                },
                "required": [
                  "min_hours",
                  "max_hours",
                  "basis",
                  "is_estimate"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "task_id",
          "name",
          "description",
          "category",
          "stage",
          "priority",
          "assigned_role",
          "dependencies",
          "inputs",
          "deliverables",
          "acceptance_criteria",
          "source_requirement_ids",
          "rationale",
          "assumptions",
          "estimated_effort"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "blocking_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "schema_version",
    "tasks",
    "blocking_questions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowStudio TaskProposal v1"
}
