# real：调用 DeepSeek（必须填 DEEPSEEK_API_KEY）；simulation：内置模拟角色，离线可跑
DISCUSSION_AGENT_MODE=real
DISCUSSION_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# 讨论轮次硬上限：超限即转人工，避免「评审每轮换措辞提新问题」无限循环
DISCUSSION_MAX_DIRECTED_ROUNDS=2
DISCUSSION_MAX_REVISION_ROUNDS=2

# 演示用：让模拟质疑者产出指定分歧类型（fact/value/tradeoff）
# value 会停在澄清卡等用户裁决；tradeoff 会先跑收敛打分再成稿
# DISCUSSION_SIMULATE_DIVERGENCE=tradeoff
